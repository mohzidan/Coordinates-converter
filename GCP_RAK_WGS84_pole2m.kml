<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>GCP RAK (WGS84, Z+2)</name>
    <description>Ground control points, WGS84. Z+2 = WGS84 ellipsoidal height (EGM2008) + 2.00 m pole height. Points are clamped to ground for display; heights are in each point's data.</description>
    <Style id="gcp">
      <IconStyle><scale>1.1</scale><Icon><href>http://maps.google.com/mapfiles/kml/shapes/target.png</href></Icon></IconStyle>
      <LabelStyle><scale>0.9</scale></LabelStyle>
    </Style>
    <Placemark>
      <name>GCP1</name>
      <styleUrl>#gcp</styleUrl>
      <description>Lat: 25.686390232
Long: 55.789079390
Z+2 (WGS84 ellipsoidal, 2.00 m pole): -31.7767 m</description>
      <ExtendedData>
        <Data name="ID"><value>GCP1</value></Data>
        <Data name="Lat"><value>25.686390232</value></Data>
        <Data name="Long"><value>55.789079390</value></Data>
        <Data name="Z+2"><value>-31.7767</value></Data>
      </ExtendedData>
      <Point>
        <altitudeMode>clampToGround</altitudeMode>
        <coordinates>55.789079390,25.686390232,0</coordinates>
      </Point>
    </Placemark>
